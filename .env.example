# ==============================================================================
# MEDICLOUD ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: This file is a template. DO NOT put real secrets in this file.
# Copy this file to .env and fill in appropriate values for local development.
# In AWS production, sensitive values must be injected via AWS Systems Manager
# Parameter Store or EC2 IAM Instance Profiles.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicloud_db
DB_USER=medicloud_user
DB_PASSWORD=medicloud_secure_dev_password
DB_SSL=false
DATABASE_URL=postgresql://medicloud_user:medicloud_secure_dev_password@localhost:5432/medicloud_db

# Security & Authentication (Argon2id / JWT)
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars_for_local_dev
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_string_for_refresh_tokens
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_secret_string

# AWS Configuration (Leave blank for AWS IAM Role on EC2 / Parameter Store)
AWS_REGION=us-east-1
# Set to 'true' to use local emulation (mock S3, mock SQS, mock SNS) for local testing before AWS connection
USE_LOCAL_CLOUD_MOCKS=true

# Amazon S3 Document Storage
AWS_S3_BUCKET_NAME=medicloud-documents-dev-bucket
AWS_S3_UPLOAD_MAX_BYTES=10485760 # 10 MB

# Amazon SQS Asynchronous Document Processing Queue
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/medicloud-document-jobs
AWS_SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/medicloud-document-jobs-dlq

# Amazon SNS Notification Service
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:medicloud-notifications-topic

# Amazon Textract OCR Processing (Optional enhancement toggle)
ENABLE_AWS_TEXTRACT=false

# AWS Systems Manager Parameter Store Prefix (for EC2 retrieval)
SSM_PARAMETER_PATH=/medicloud/production/

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_CLOUDWATCH_LOGS=false
CLOUDWATCH_LOG_GROUP=/medicloud/application
